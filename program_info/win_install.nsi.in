!include "FileFunc.nsh"
!include "LogicLib.nsh"
!include "MUI2.nsh"
!include "nsDialogs.nsh"

!include "x64.nsh"

AllowSkipFiles off
Unicode true

Name "@Launcher_DisplayName@"
InstallDir "$LOCALAPPDATA\Programs\@Launcher_CommonName@"
InstallDirRegKey HKCU "Software\@Launcher_CommonName@" "InstallDir"
RequestExecutionLevel user
OutFile "../Obsidium-Setup.exe"

!define MUI_ICON "../@Launcher_Branding_ICO@"

!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\@Launcher_CommonName@"

; PolyTech: the installer offers two kinds of install.
;   portable  - everything (launcher, packs, settings) in the chosen folder, marked by
;               portable.txt; nothing is registered in Windows.
;   installed - classic install: Start Menu entry, "Apps & features" entry with an
;               uninstaller; packs and settings live in %APPDATA%.
Var InstallMode          ; "portable" / "installed", empty until the type page is left
Var PreferredMode        ; what the type page preselects
Var DefaultInstalledDir  ; InstallDir, or the previous install's folder from the registry
Var DirTopText           ; directory page text, depends on the mode
Var NoShortcuts          ; /NoShortcuts on the command line
Var RadioPortable
Var RadioInstalled

;--------------------------------

; Pages

!insertmacro MUI_PAGE_WELCOME
Page custom ModePageCreate ModePageLeave
!define MUI_DIRECTORYPAGE_TEXT_TOP "$DirTopText"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$InstDir\@Launcher_APP_BINARY_NAME@.exe"
; The second checkbox of the finish page creates the desktop shortcut (checked by default).
!define MUI_FINISHPAGE_SHOWREADME ""
!define MUI_FINISHPAGE_SHOWREADME_TEXT "$(FINISH_DESKTOP)"
!define MUI_FINISHPAGE_SHOWREADME_FUNCTION CreateDesktopShortcut
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

